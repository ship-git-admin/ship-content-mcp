{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/draft_patch.schema.json",
  "title": "MCP Draft Update Contract",
  "description": "Validates top-level shape only; server MUST check taxonomy/field/ACF/location/post ACL and optimistic concurrency.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "post_id",
    "post_type",
    "if_match",
    "changes",
    "idempotency_key"
  ],
  "properties": {
    "post_id": {
      "type": "integer",
      "minimum": 1
    },
    "post_type": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "if_match": {
      "type": "string",
      "minLength": 1
    },
    "idempotency_key": {
      "type": "string",
      "minLength": 8,
      "maxLength": 128
    },
    "changes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 200,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "value"
            ],
            "properties": {
              "kind": {
                "const": "post_title"
              },
              "value": {
                "type": "string",
                "maxLength": 300
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "value"
            ],
            "properties": {
              "kind": {
                "const": "post_content"
              },
              "value": {
                "type": "string",
                "maxLength": 1000000
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "attachment_id"
            ],
            "properties": {
              "kind": {
                "const": "featured_media"
              },
              "attachment_id": {
                "type": "integer",
                "minimum": 1
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "field_key",
              "value"
            ],
            "properties": {
              "kind": {
                "const": "acf_field"
              },
              "field_key": {
                "type": "string",
                "pattern": "^field_[A-Za-z0-9_]+$"
              },
              "value": {}
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "taxonomy",
              "term_ids"
            ],
            "properties": {
              "kind": {
                "const": "taxonomy_terms"
              },
              "taxonomy": {
                "type": "string",
                "pattern": "^[a-z0-9_\\-]+$"
              },
              "term_ids": {
                "type": "array",
                "uniqueItems": true,
                "maxItems": 100,
                "items": {
                  "type": "integer",
                  "minimum": 1
                }
              }
            }
          }
        ]
      }
    }
  }
}
