{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/policy_output.schema.json",
  "title": "Natural language content policy",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "post_type",
    "site_policy",
    "type_policy",
    "version"
  ],
  "properties": {
    "post_type": {
      "type": "string"
    },
    "site_policy": {
      "type": "string"
    },
    "type_policy": {
      "type": "string"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
